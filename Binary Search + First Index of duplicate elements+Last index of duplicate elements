#include <stdio.h>

int main(int BinarySearch(int arr[],int size,int target){
    int low=0;
    int high = size-1;
    int mid;
    while(low<=high){
        mid=low+(high-low)/2;
        if(arr[mid]==target){
            return mid;
        }
        else if(arr[mid]<target){
            low=mid+1;
        }
        else{
            high=mid-1;
        }
    }
    return -1;
}
int FirstIndex(int arr[],int size,int target){
    for(int i=0;i<size-1;i++){
        if(arr[i]==target){
            return i;
        }
    }
    return -1;
}
int LastIndex(int arr[],int size,int target){
    for(int j=size-1;j>=0;j--){
        if(arr[j]==target){
            return j;
        }
    }
